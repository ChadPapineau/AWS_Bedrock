# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# Bedrock Model Configuration
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=4096

# AgentCore Configuration
AGENTCORE_MEMORY_ID=
AGENTCORE_RUNTIME_ENDPOINT=

# Tool API Keys (for local development)
TAVILY_API_KEY=
GITHUB_TOKEN=

# CyberArk Secure AI Agents
# See README for setup instructions: Identity service user + Discovery & Context role
CYBERARK_TENANT_NAME=
CYBERARK_SCANNER_BUCKET=
CYBERARK_SCANNER_REGION=us-east-1

# Local Development
LOCAL_DEV=1
LOG_LEVEL=INFO
